__pycache__
.venv
.env

# Machine-local devcontainer settings -- the AWS_PROFILE to use, mainly.
# local.env.example is the tracked copy that documents it.
.devcontainer/local.env

logs/
# A local copy of endgame's processed play-by-play (`make plays`), and what
# gets built from it. Both are rebuildable output, not source.
plays/
stints/
# ...and of the game summaries endgame stores (`make summaries`).
summaries/
# ...and of so-high-school's recruits (`make recruits`): ESPN's, not to commit.
recruits/
# ...and the per-season caches `chain` reads (`build.py chain_weeks`).
chain-weeks/
# ...and ESPN's roster responses (`make rosters`)
rosters/
